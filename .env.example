# PowerShell 不会自动加载此文件；请按 README 设置环境变量。
MYSQL_DSN=lifemate:lifemate_dev@tcp(127.0.0.1:3306)/lifemate?charset=utf8mb4&parseTime=true&loc=UTC
HTTP_ADDR=:8081
REDIS_URL=redis://127.0.0.1:16380/0
REDIS_PORT=16380
GIN_MODE=release
ROCKETMQ_NAMESERVERS=127.0.0.1:9876
ROCKETMQ_TOPIC=lifemate-seckill-orders-v2
ROCKETMQ_PRODUCER_GROUP=lifemate-seckill-producer
ROCKETMQ_CONSUMER_GROUP=lifemate-seckill-consumer-v2
ROCKETMQ_TIMEOUT_TOPIC=lifemate-seckill-timeouts-v2
ROCKETMQ_SCHEDULE_GROUP=lifemate-seckill-scheduler-v2
ROCKETMQ_CLOSE_GROUP=lifemate-seckill-closer-v2
ROCKETMQ_ORDER_CONCURRENCY=4
ROCKETMQ_SCHEDULE_CONCURRENCY=4
ROCKETMQ_CLOSE_CONCURRENCY=4
# Redis 预扣成功起计时；预订单在截止时间后继续保留24小时。
ORDER_PAYMENT_TIMEOUT=1m
ORDER_PREORDER_GRACE=24h
# 秒杀限流：每秒补充速率与最大桶容量；开发默认值，非实测容量承诺。
SECKILL_LIMIT_PREFIX=rate:limit:seckill
SECKILL_GLOBAL_RATE=100
SECKILL_GLOBAL_BURST=100
SECKILL_USER_RATE=1
SECKILL_USER_BURST=2
